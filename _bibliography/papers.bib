@misc{bichler2026language,
  abbr={arXiv},
  title={How language model agents reshape price competition},
  author={Bichler, Martin and Hierhager, Philip and K{\"o}ck, Kassian and Pieroth, Fabian},
  year={2026},
  eprint={2610.21711},
  arxiv={2610.21711},
  archivePrefix={arXiv},
  primaryClass={cs.GT},
  url={https://arxiv.org/abs/2610.21711},
  pdf={https://arxiv.org/pdf/2610.21711},
  selected={true},
  abstract={This paper studies language model pricing agents in repeated Bertrand competition. Their behavior depends on deployment choices: agents using raw market histories that include rival prices can sustain supracompetitive prices in self-play, while agents using summarized histories of their own profits tend toward competitive prices. Mixed deployments can produce dynamic pricing regimes that keep both competitors' prices above marginal cost.}
}

@misc{hierhager2026liouville,
  abbr={arXiv},
  title={Liouville-Preserving Hamiltonian Scattering on Finite Metric Graphs},
  author={Hierhager, Philip},
  year={2026},
  eprint={2606.05973},
  arxiv={2606.05973},
  archivePrefix={arXiv},
  primaryClass={math-ph},
  url={https://arxiv.org/abs/2606.05973},
  pdf={https://arxiv.org/pdf/2606.05973},
  selected={true},
  abstract={This paper studies deterministic Hamiltonian dynamics on finite metric graphs. Since energy conservation alone does not determine how a trajectory continues through a branching vertex, the paper introduces energy-preserving vertex scattering maps. The resulting edge-and-vertex dynamics define a global measurable flow that preserves energy and the quotient Liouville measure.}
}
